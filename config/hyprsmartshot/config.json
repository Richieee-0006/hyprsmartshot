{
  "language": "en",
  "ocrLanguages": "eng",
  "postSaveHook": "",
  "postCopyHook": "",
  "activePreset": "default",
  "presets": {
    "default": {
      "name": "Default",
      "offsetX": 0,
      "offsetY": 0,
      "inset": 0,
      "filter": "all"
    },
    "browser": {
      "name": "Browser",
      "offsetX": 0,
      "offsetY": 0,
      "inset": 0,
      "filter": "content"
    },
    "terminal": {
      "name": "Terminal",
      "offsetX": 0,
      "offsetY": 0,
      "inset": 1,
      "filter": "window"
    },
    "game": {
      "name": "Game",
      "offsetX": 0,
      "offsetY": 0,
      "inset": 0,
      "filter": "dense"
    }
  },
  "appRules": {
    "firefox": "browser",
    "librewolf": "browser",
    "google-chrome": "browser",
    "chromium": "browser",
    "brave-browser": "browser",
    "vivaldi": "browser",
    "floorp": "browser",
    "zen-browser": "browser",
    "discord": "browser",
    "vesktop": "browser",
    "webcord": "browser",
    "equibop": "browser",
    "obsidian": "browser",
    "com.mojang.minecraft": "game",
    "minecraft": "game",
    "steam_app": "game",
    "gamescope": "game",
    "lutris": "game",
    "prismlauncher": "game",
    "kitty": "terminal",
    "alacritty": "terminal",
    "foot": "terminal",
    "ghostty": "terminal",
    "wezterm": "terminal",
    "konsole": "terminal",
    "gnome-terminal": "terminal"
  },
  "theme": {
    "mode": "pywal",
    "pywalPath": "~/.cache/wal/colors.json",
    "liveWatch": true,
    "syncSatty": false,
    "syncPinWindow": true,
    "dimOpacity": 0.65,
    "borderRadius": 10,
    "outlineThickness": 2,
    "pinBorderWidth": 2,
    "fontFamily": "JetBrainsMono Nerd Font",
    "pywalMap": {
      "accent": "color1",
      "accentHover": "color9",
      "selectionBorder": "color2",
      "snapBorder": "color3",
      "aiAccent": "color5",
      "pinBorder": "color4",
      "danger": "color1",
      "barBorder": "color8",
      "textSubtle": "color7"
    },
    "overrides": {}
  },
  "detection": {
    "enableText": true,
    "enablePanels": true,
    "enableGrids": true,
    "enableWindowContent": true,
    "minArea": 64,
    "maxAreaRatio": 0.98,
    "tinyContrastMin": 4.5,
    "adaptiveTextThreshold": true,
    "filterIconsFromText": true,
    "multiColumnParagraphs": true,
    "maxHeaderHeight": 96
  },
  "rating": {
    "enabled": true,
    "minConfidence": 0.30,
    "adaptiveLearning": true,
    "learningRate": 0.08,
    "profilePath": "",
    "weights": {
      "contrast": 0.24,
      "geometry": 0.18,
      "edge": 0.22,
      "interior": 0.14,
      "semantic": 0.12,
      "presetFit": 0.10
    }
  },
  "ai": {
    "enabled": false,
    "trigger": "manual",
    "provider": "openai_compatible",
    "timeoutMs": 35000,
    "maxImageDim": 960,
    "defaultAction": "ocr",
    "prompt": "Detect up to 12 key UI regions (windows, panels, sidebar, dialogs, buttons, inputs, dock, text blocks). Coordinates are normalized 0..1000 where x1,x2 are horizontal (left=0, right=1000) and y1,y2 are vertical (top=0, bottom=1000). Return strict JSON array: [{\"label\":\"...\",\"type\":\"panel|button|input|slot|text_block\",\"x1\":0,\"y1\":0,\"x2\":500,\"y2\":900,\"confidence\":0.9}]",
    "providers": {
      "copilot": {
        "baseUrl": "http://127.0.0.1:4141/v1",
        "model": "gpt-4.1",
        "apiKeyEnv": "GITHUB_TOKEN",
        "apiKey": ""
      },
      "local_llm": {
        "baseUrl": "http://127.0.0.1:8080/v1",
        "model": "qwen3.6-35b-vision",
        "apiKeyEnv": "OPENAI_API_KEY",
        "apiKey": ""
      },
      "ollama": {
        "baseUrl": "http://127.0.0.1:11434/v1",
        "model": "qwen2.5vl:7b",
        "apiKeyEnv": "",
        "apiKey": ""
      },
      "ovhcloud": {
        "baseUrl": "https://oai.endpoints.kepler.ai.cloud.ovh.net/v1",
        "model": "Qwen2.5-VL-72B-Instruct",
        "apiKeyEnv": "OVH_API_KEY",
        "apiKey": ""
      },
      "kilo": {
        "baseUrl": "https://api.kilo.ai/api/gateway",
        "model": "nvidia/nemotron-3.5-super-vl:free",
        "apiKeyEnv": "KILO_API_KEY",
        "apiKey": ""
      },
      "gemini": {
        "baseUrl": "https://generativelanguage.googleapis.com/v1beta",
        "model": "gemini-3.8-flash",
        "apiKeyEnv": "GEMINI_API_KEY",
        "apiKey": ""
      },
      "openrouter": {
        "baseUrl": "https://openrouter.ai/api/v1",
        "model": "google/gemma-4-31b-it:free",
        "apiKeyEnv": "OPENROUTER_API_KEY",
        "apiKey": ""
      },
      "groq": {
        "baseUrl": "https://api.groq.com/openai/v1",
        "model": "qwen/qwen3.8-27b",
        "apiKeyEnv": "GROQ_API_KEY",
        "apiKey": ""
      },
      "mistral": {
        "baseUrl": "https://api.mistral.ai/v1",
        "model": "mistral-medium-3-5",
        "apiKeyEnv": "MISTRAL_API_KEY",
        "apiKey": ""
      },
      "openai_compatible": {
        "baseUrl": "http://127.0.0.1:8080/v1",
        "model": "qwen3.6-35b-vision",
        "apiKeyEnv": "OPENAI_API_KEY",
        "apiKey": ""
      }
    }
  },
  "ui": {
    "showConfidenceBadge": true,
    "sortByRating": true,
    "showMagnifierByDefault": false,
    "magnifierZoom": 3.0,
    "magnifierSize": 180,
    "showHints": true,
    "animations": true
  },
  "capture": {
    "imageFormat": "png",
    "pngCompression": 4,
    "defaultSaveDir": "",
    "copyAfterSave": true
  }
}
