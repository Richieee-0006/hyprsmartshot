# Maintainer: Richieee <https://github.com/Richieee-0006>
pkgname=hyprsmartshot-git
pkgver=2.0.0.r0.g0000000
pkgrel=1
pkgdesc="Standalone C++23 Wayland screenshot & CV utility crafted for Hyprland (git version)"
arch=('x86_64' 'aarch64')
url="https://github.com/Richieee-0006/hyprsmartshot"
license=('MIT')
depends=(
    'cairo'
    'curl'
    'libjpeg-turbo'
    'libpng'
    'libxkbcommon'
    'opencv'
    'pango'
    'wayland'
)
makedepends=(
    'cmake'
    'git'
    'gtk4'
    'ninja'
    'nlohmann-json'
    'pkgconf'
    'systemd-libs'
    'wayland-protocols'
)
optdepends=(
    'gtk4: On-demand GTK4 Settings GUI (hyprsmartshot-settings)'
    'satty: Screenshot annotation editor'
    'swappy: Alternative annotation tool fallback'
    'tesseract: Local OCR text recognition'
    'tesseract-data-eng: English OCR language data'
    'tesseract-data-ces: Czech OCR language data'
    'wl-clipboard: Clipboard fallback when compositor lacks ext-data-control-v1'
    'libcanberra: Camera shutter sound effect'
    'libnotify: Desktop notifications fallback'
)
provides=('hyprsmartshot')
conflicts=('hyprsmartshot')
source=("$pkgname::git+$url.git#branch=main"
        "hyprsmartshot.desktop")
sha256sums=('SKIP'
            '7947f3de6f3d75c8518a14ba4cd6840565432a5b41609b366bad6e0cee63290f')

pkgver() {
    cd "$srcdir/$pkgname"
    git describe --long --tags --abbrev=7 2>/dev/null | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g' || printf "2.0.0.r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

build() {
    cd "$srcdir/$pkgname"
    cmake -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DENABLE_TESTS=ON \
        -DBUILD_SETTINGS_GUI=ON
    cmake --build build
}

check() {
    cd "$srcdir/$pkgname"
    ctest --test-dir build --output-on-failure
}

package() {
    cd "$srcdir/$pkgname"
    DESTDIR="$pkgdir" cmake --install build
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
