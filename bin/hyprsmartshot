#!/usr/bin/env bash
# HyprSmartShot - Runner & Integrator
# Captures freeze-frame, runs CV detector, and launches Quickshell overlay

set -e

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
FREEZE_IMG="/tmp/hyprsmartshot_freeze.png"
BOXES_JSON="/tmp/hyprsmartshot_boxes.json"
CLIENTS_JSON="/tmp/hyprsmartshot_clients.json"
VENV_PYTHON="$DIR/.venv/bin/python"
CV_SCRIPT="$DIR/vision/detect_ui.py"
CLEANUP_PID_FILE="/tmp/hyprsmartshot_cleanup.pid"

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/hyprsmartshot"
CONFIG_FILE="$CONFIG_DIR/config.json"
CONFIG_TOML="$CONFIG_DIR/config.toml"
DEFAULT_CONFIG="$DIR/config/hyprsmartshot/config.json"

# Resolve language preference (default: "en", with dynamic arbitrary language code support)
if [ -z "$SMARTSHOT_LANG" ]; then
    if [ -f "$CONFIG_FILE" ]; then
        SMARTSHOT_LANG=$(jq -r '.language // empty' "$CONFIG_FILE" 2>/dev/null || true)
    fi
    if [ -z "$SMARTSHOT_LANG" ] && [ -f "$CONFIG_TOML" ]; then
        SMARTSHOT_LANG=$(grep -E '^\s*language\s*=' "$CONFIG_TOML" 2>/dev/null | sed -E 's/.*=\s*["'\'']?([^"'\'']+)["'\'']?.*/\1/' || true)
    fi
    if [ -z "$SMARTSHOT_LANG" ] && [ -f "$DEFAULT_CONFIG" ]; then
        SMARTSHOT_LANG=$(jq -r '.language // empty' "$DEFAULT_CONFIG" 2>/dev/null || true)
    fi
fi
# Sanitize language code (strip encoding like .UTF-8/whitespace, allow only alphanumeric, underscores, hyphens)
SMARTSHOT_LANG="${SMARTSHOT_LANG%%.*}"
SMARTSHOT_LANG=$(echo "$SMARTSHOT_LANG" | tr -d '[:space:]')
if [[ ! "$SMARTSHOT_LANG" =~ ^[a-zA-Z0-9_-]+$ ]]; then
    SMARTSHOT_LANG="en"
fi
export SMARTSHOT_LANG
export SMARTSHOT_DIR="$DIR"

get_translation() {
    local key="$1"
    local default_val="$2"
    local lang="${SMARTSHOT_LANG:-en}"
    local base_lang="${lang%%[_-]*}"

    local search_files=(
        "$CONFIG_DIR/localization/${lang}.json"
        "$DIR/localization/${lang}.json"
    )
    if [ -n "$base_lang" ] && [ "$base_lang" != "$lang" ]; then
        search_files+=(
            "$CONFIG_DIR/localization/${base_lang}.json"
            "$DIR/localization/${base_lang}.json"
        )
    fi
    search_files+=(
        "$CONFIG_DIR/localization/en.json"
        "$DIR/localization/en.json"
    )

    local val=""
    for f in "${search_files[@]}"; do
        if [ -f "$f" ]; then
            val=$(jq -r --arg k "$key" '.[$k] // empty' "$f" 2>/dev/null || true)
            if [ -n "$val" ] && [ "$val" != "null" ]; then
                echo "$val"
                return 0
            fi
        fi
    done
    echo "$default_val"
}

# Kill any lingering background cleanup from previous runs to prevent deleting the new freeze image
if [ -f "$CLEANUP_PID_FILE" ]; then
    OLD_CLEANUP_PID=$(cat "$CLEANUP_PID_FILE" 2>/dev/null || true)
    if [ -n "$OLD_CLEANUP_PID" ]; then
        kill "$OLD_CLEANUP_PID" 2>/dev/null || true
    fi
    rm -f "$CLEANUP_PID_FILE" 2>/dev/null || true
fi

# Clean up stale files from previous runs and terminate any lingering hyprsmartshot overlay
quickshell kill -p "$DIR" >/dev/null 2>&1 || true
pkill -f "quickshell -p $DIR" >/dev/null 2>&1 || true
rm -f "$FREEZE_IMG" "$BOXES_JSON" "$CLIENTS_JSON" /tmp/hyprsmartshot_crop_*.png /tmp/hyprsmartshot_ocr_*.png /tmp/hyprsmartshot_annot_*.png 2>/dev/null || true
echo '{"boxes":[]}' > "$BOXES_JSON"

# Deferred cleanup on exit to ensure detached background processes (magick, wl-copy) complete safely
cleanup() {
    quickshell kill -p "$DIR" >/dev/null 2>&1 || true
    pkill -f "quickshell -p $DIR" >/dev/null 2>&1 || true
    ( sleep 8 && rm -f "$FREEZE_IMG" "$BOXES_JSON" "$CLIENTS_JSON" /tmp/hyprsmartshot_crop_*.png /tmp/hyprsmartshot_ocr_*.png /tmp/hyprsmartshot_annot_*.png "$CLEANUP_PID_FILE" 2>/dev/null ) &
    echo $! > "$CLEANUP_PID_FILE" 2>/dev/null || true
}
trap cleanup EXIT INT TERM

MODE="${1:-universal}"

# Query focused monitor details from Hyprland
MONITOR_JSON=$(hyprctl monitors -j 2>/dev/null | jq -r '.[] | select(.focused == true)' 2>/dev/null || echo "")
if [ -z "$MONITOR_JSON" ] || [ "$MONITOR_JSON" = "null" ]; then
    MONITOR_JSON=$(hyprctl monitors -j 2>/dev/null | jq -r '.[0]' 2>/dev/null || echo "")
fi

MONITOR_NAME=$(echo "$MONITOR_JSON" | jq -r '.name // empty' 2>/dev/null || echo "")
MONITOR_X=$(echo "$MONITOR_JSON" | jq -r '.x // 0' 2>/dev/null || echo "0")
MONITOR_Y=$(echo "$MONITOR_JSON" | jq -r '.y // 0' 2>/dev/null || echo "0")
MONITOR_W=$(echo "$MONITOR_JSON" | jq -r '.width // 1920' 2>/dev/null || echo "1920")
MONITOR_H=$(echo "$MONITOR_JSON" | jq -r '.height // 1080' 2>/dev/null || echo "1080")
MONITOR_SCALE=$(echo "$MONITOR_JSON" | jq -r '.scale // 1' 2>/dev/null || echo "1")

export SMARTSHOT_MONITOR_NAME="$MONITOR_NAME"
export SMARTSHOT_MONITOR_X="$MONITOR_X"
export SMARTSHOT_MONITOR_Y="$MONITOR_Y"
export SMARTSHOT_MONITOR_W="$MONITOR_W"
export SMARTSHOT_MONITOR_H="$MONITOR_H"
export SMARTSHOT_MONITOR_SCALE="$MONITOR_SCALE"
MONITOR_ACTIVE_WORKSPACE=$(echo "$MONITOR_JSON" | jq -r '.activeWorkspace.id // empty' 2>/dev/null || echo "")
export SMARTSHOT_WORKSPACE_ID="$MONITOR_ACTIVE_WORKSPACE"

play_shutter() {
    canberra-gtk-play -i camera-shutter 2>/dev/null || paplay /usr/share/sounds/freedesktop/stereo/camera-shutter.oga 2>/dev/null || true
}

# Fast fullscreen bypass if user called 'full'
if [ "$MODE" = "full" ]; then
    SAVE_DIR="${XDG_PICTURES_DIR:-$HOME/Pictures}/Screenshots"
    mkdir -p "$SAVE_DIR"
    TIMESTAMP=$(date +%Y-%m-%d_%H-%M-%S)
    FILEPATH="$SAVE_DIR/screenshot-$TIMESTAMP.png"
    if [ -n "$MONITOR_NAME" ]; then
        grim -o "$MONITOR_NAME" "$FILEPATH"
    else
        grim "$FILEPATH"
    fi
    play_shutter &
    wl-copy --type image/png < "$FILEPATH"
    FS_TITLE=$(get_translation "fullscreenTitle" "Fullscreen Captured")
    FS_DESC_FMT=$(get_translation "fullscreenDesc" "Saved to {path} and copied to clipboard")
    shopt -u patsub_replacement 2>/dev/null || true
    FS_DESC="${FS_DESC_FMT/\{path\}/$FILEPATH}"
    notify-send -a "HyprSmartShot" -i "$FILEPATH" "$FS_TITLE" "$FS_DESC"
    exit 0
fi

# 1. Instant screen freeze (fast level 1 PNG compression)
if [ -n "$MONITOR_NAME" ]; then
    grim -l 1 -o "$MONITOR_NAME" "$FREEZE_IMG" 2>/dev/null || grim -l 1 "$FREEZE_IMG"
else
    grim -l 1 "$FREEZE_IMG"
fi

# Ensure freeze image exists and is non-empty
if [ ! -s "$FREEZE_IMG" ]; then
    grim "$FREEZE_IMG"
fi

# Snapshot Hyprland client windows for instant window snapping without socket delay
hyprctl clients -j > "$CLIENTS_JSON" 2>/dev/null || echo "[]" > "$CLIENTS_JSON"

# 2. Run Computer Vision UI detection in background
"$VENV_PYTHON" "$CV_SCRIPT" "$FREEZE_IMG" "$BOXES_JSON" "$CLIENTS_JSON" &
CV_PID=$!

# 3. Export mode to Quickshell (universal is all-in-one Smart mode)
case "$MODE" in
    screen|full) export SMARTSHOT_MODE="screen" ;;
    *)           export SMARTSHOT_MODE="universal" ;;
esac

# 4. Wait briefly for CV to finish (takes ~30-60ms, bounded to 100ms max so overlay never hangs)
for _ in {1..10}; do
    if ! kill -0 "$CV_PID" 2>/dev/null; then
        break
    fi
    sleep 0.01
done

# 5. Launch Quickshell overlay
quickshell -p "$DIR" || true
